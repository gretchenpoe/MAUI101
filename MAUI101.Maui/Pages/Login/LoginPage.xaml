<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI101.Maui.Pages.LoginPage"
             xmlns:viewmodels="clr-namespace:MAUI101.Maui.ViewModels"
             Title="LoginPage"
            x:DataType="viewmodels:LoginViewModel">
    <VerticalStackLayout 
          Padding="30,30"
          Spacing="15">
          <Label Text="Login" 
               Style="{StaticResource SubHeadline}"
               SemanticProperties.HeadingLevel="Level2" FontAttributes="Bold"/>
          <Label Text="User Name" FontAttributes="Bold"/>
               <Entry Text="{Binding UserName, Mode=TwoWay}" 
                    Placeholder="Enter your user name" 
                    MaxLength="100"/>

               <Label Text="Password" FontAttributes="Bold"/>
               <Entry Text="{Binding Password, Mode=TwoWay}" 
                    Placeholder="Enter your password" 
                    MaxLength="100"
                    IsPassword="True"/>
               <!-- Submit Button -->
               <Button Text="Login" 
                    Command="{Binding ValidateUserCommand}"
                    Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>