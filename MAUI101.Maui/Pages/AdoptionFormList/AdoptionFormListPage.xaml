<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI101.Maui.Pages.AdoptionFormListPage"
             xmlns:models="clr-namespace:MAUI101.Maui.Models"
             Title="Adoption Forms">
    <Grid>
        <CollectionView x:Name="collectionView"
                            Margin="20"
                            SelectionMode="Single"
                            SelectionChanged="OnCollectionViewSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AdoptionForm">
                        <Grid HorizontalOptions="Fill" Padding="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="25" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="1" 
                                Text="{Binding Id, StringFormat='Adoption Form # {0}'}" 
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation" />
                            <Label Grid.Row="1"
                                Grid.Column="1" 
                                Text="{Binding PetName, StringFormat='Pet Name: {0}'}"
                                LineBreakMode="WordWrap"
                                VerticalOptions="Start" />
                            <BoxView Grid.Column="1" 
                                    Grid.Row="2"
                                    HeightRequest="1" 
                                    Color="{AppThemeBinding Light={StaticResource Disabled}, Dark={StaticResource DisabledDark}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
        </CollectionView>
        <Label HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource Disabled}, Dark={StaticResource DisabledDark}}"
               x:Name="nothingYetLabel"
               Text="Nothing here yet!"
               FontAttributes = "Bold"
               IsVisible="false"/>
    </Grid>
</ContentPage>