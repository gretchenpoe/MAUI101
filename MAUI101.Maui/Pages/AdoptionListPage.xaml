<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI101.Maui.Models"
             x:Class="MAUI101.Maui.Pages.AdoptionListPage"
             Title="Pets Available for Adoption">
    <CollectionView x:Name="collectionView"
                        Margin="20"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Pet">
                    <Grid Padding="20,0,0,0"
                        ColumnDefinitions="0.9*, 0.1*">
                        <Label Text="{Binding ID}" 
                            VerticalTextAlignment="Center" />
                        <Image Grid.Column="1"
                            Source="{Binding Url}" 
                            HorizontalOptions="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>