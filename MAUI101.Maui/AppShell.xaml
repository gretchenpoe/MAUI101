<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MAUI101.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MAUI101.Maui.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="MAUI101.Maui"
    Shell.BackgroundColor="#639e54"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.TabBarBackgroundColor="#639e54"
    Shell.TabBarForegroundColor="White"
    Shell.TabBarTitleColor="White"
    Shell.TabBarUnselectedColor="#beebb2">

    <TabBar>
        <Tab Title="Home" Icon="home.png">
            <ShellContent Title="Home" ContentTemplate="{DataTemplate local:AboutPage}" />
        </Tab>
        <Tab Title="Adopt" Icon="heart.png">
            <ShellContent ContentTemplate="{DataTemplate local:AdoptionListPage}" />
        </Tab>
        <Tab Title="Forms" Icon="folder.png">
            <ShellContent ContentTemplate="{DataTemplate local:AdoptionFormListPage}" />
        </Tab>
    </TabBar>

</Shell>
